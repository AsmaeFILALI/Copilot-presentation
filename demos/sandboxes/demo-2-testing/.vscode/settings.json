{
  // The spec'd version of pricing.py must not reach the model before step 4,
  // or /tests will generate the CORRECT assertion and the demo has no punchline.
  "files.exclude": {
    "_staged": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  "search.exclude": {
    "_staged": true
  },
  "python.testing.pytestArgs": [
    "."
  ],
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true
}
